{
  "name": "@coaching-webrtc/native",
  "version": "0.1.0",
  "description": "React Native (bare + Expo dev client) video calling SDK (headless hook + prebuilt CallScreen) with speaker routing + boosted remote audio. Requires react-native-webrtc native code — does NOT run in Expo Go, see README.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@coaching-webrtc/core": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-webrtc": ">=124.0.0",
    "react-native-incall-manager": ">=4.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-incall-manager": "^4.2.2",
    "tsdown": "^0.9.0",
    "typescript": "^5.6.0"
  }
}
