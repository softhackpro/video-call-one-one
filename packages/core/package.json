{
  "name": "@coaching-webrtc/core",
  "version": "0.1.0",
  "description": "Platform-agnostic signaling client and call state machine for @coaching-webrtc SDKs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
